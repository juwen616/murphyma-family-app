rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net & Super Admin Override
    match /{document=**} {
      allow read, write: if isSignedIn() && isSuperAdmin(request.auth.uid);
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserFamilyId(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ? 
        get(/databases/$(database)/documents/users/$(uid)).data.get('familyId', null) : null;
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ? 
        get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'none') : 'none';
    }

    function getUserSystemRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ? 
        get(/databases/$(database)/documents/users/$(uid)).data.get('systemRole', 'none') : 'none';
    }

    function isSuperAdmin(uid) {
      return isSignedIn() && (
        request.auth.token.email == "juwen616@gmail.com" || 
        request.auth.token.email == "Juwen616@gmail.com" || 
        request.auth.token.email == "JUWEN616@gmail.com" || 
        getUserRole(uid) == "SuperAdmin" || 
        getUserRole(uid) == "ADMIN" || 
        getUserRole(uid) == "admin" ||
        getUserSystemRole(uid) == "SUPER_ADMIN"
      );
    }

    function isMemberOfFamily(familyId) {
      return isSignedIn() && (
        request.auth.token.email == "juwen616@gmail.com" ||
        request.auth.token.email == "Juwen616@gmail.com" ||
        request.auth.token.email == "JUWEN616@gmail.com" ||
        getUserFamilyId(request.auth.uid) == familyId || 
        isSuperAdmin(request.auth.uid)
      );
    }

    function isUserParentOrAdmin(uid) {
      return isSuperAdmin(uid) || getUserRole(uid) == "Owner" || getUserRole(uid) == "Parent" || getUserRole(uid) == "admin" || getUserRole(uid) == "parent";
    }

    function isUserAdmin(uid) {
      return isSuperAdmin(uid) || getUserRole(uid) == "Owner" || getUserRole(uid) == "admin";
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || 
        getUserFamilyId(request.auth.uid) == resource.data.get('familyId', null) ||
        isSuperAdmin(request.auth.uid)
      );
      allow list: if isSignedIn() && (
        getUserFamilyId(request.auth.uid) == resource.data.get('familyId', null) ||
        isSuperAdmin(request.auth.uid)
      );
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (getUserFamilyId(request.auth.uid) == request.resource.data.get('familyId', null) && isUserParentOrAdmin(request.auth.uid)) ||
        isSuperAdmin(request.auth.uid)
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        (getUserFamilyId(request.auth.uid) == resource.data.get('familyId', null) && isUserParentOrAdmin(request.auth.uid)) ||
        isSuperAdmin(request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        (getUserFamilyId(request.auth.uid) == resource.data.get('familyId', null) && isUserParentOrAdmin(request.auth.uid)) ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // 2. Families Collection
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (getUserFamilyId(request.auth.uid) == familyId && isUserAdmin(request.auth.uid)) || isSuperAdmin(request.auth.uid);
      allow delete: if isSignedIn() && isSuperAdmin(request.auth.uid);
    }

    // 3. Family Members Collection
    match /family_members/{memberId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (
        isMemberOfFamily(request.resource.data.get('familyId', null)) ||
        get(/databases/$(database)/documents/families/$(request.resource.data.get('familyId', null))).data.get('adminUid', null) == request.auth.uid ||
        isSuperAdmin(request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        ((isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid)) && (
          request.auth.uid == resource.data.get('userId', null) || 
          isUserParentOrAdmin(request.auth.uid)
        ))
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        isMemberOfFamily(resource.data.get('familyId', null))
      );
    }

    // 4. Calendar Events Collection
    match /calendar_events/{eventId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update, delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        (isMemberOfFamily(resource.data.get('familyId', null)) && (
          isUserParentOrAdmin(request.auth.uid) || 
          resource.data.get('creatorUid', null) == request.auth.uid
        ))
      );
    }

    // 5. Tasks Collection
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        (isMemberOfFamily(resource.data.get('familyId', null)) && (
          isUserParentOrAdmin(request.auth.uid) || 
          request.auth.uid == resource.data.get('assignedTo', null) || 
          resource.data.get('assignedTo', null) == "all"
        ))
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid))
      );
    }

    // 6. Rewards Collection
    match /rewards/{rewardId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        (isMemberOfFamily(resource.data.get('familyId', null)) && (
          isUserParentOrAdmin(request.auth.uid) || 
          request.auth.uid == resource.data.get('creatorUid', null) ||
          (getUserRole(request.auth.uid) == "kid" && resource.data.get('status', null) == "available")
        ))
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid))
      );
    }

    // 7. Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) || 
        (isMemberOfFamily(resource.data.get('familyId', null)) && (
          isUserParentOrAdmin(request.auth.uid) || 
          resource.data.get('creatorUid', null) == request.auth.uid
        ))
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) || 
        (isMemberOfFamily(resource.data.get('familyId', null)) && (
          isUserParentOrAdmin(request.auth.uid) || 
          resource.data.get('creatorUid', null) == request.auth.uid
        ))
      );
    }

    // 7b. Family Notes Collection
    match /family_notes/{noteId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
      allow delete: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
    }

    // 8. Common Templates Collection
    match /commonTemplates/{templateId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
      allow delete: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
    }

    // 8b. Favorite Activities Collection
    match /favorite_activities/{activityId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
      allow delete: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
    }

    // 8c. Redemptions Collection
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update, delete: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
    }

    // 9. Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn() && (isMemberOfFamily(settingId) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        isMemberOfFamily(settingId) || 
        get(/databases/$(database)/documents/families/$(settingId)).data.get('adminUid', null) == request.auth.uid
      );
      allow update: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(settingId) && isUserParentOrAdmin(request.auth.uid)));
      allow delete: if isSignedIn() && isSuperAdmin(request.auth.uid);
    }

    // 10. Travel Modes Collection
    match /travel_modes/{modeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUserParentOrAdmin(request.auth.uid);
    }

    // 11. Star Transactions Collection
    match /star_transactions/{transactionId} {
      allow read: if isSignedIn() && (isMemberOfFamily(resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow create: if isSignedIn() && (isMemberOfFamily(request.resource.data.get('familyId', null)) || isSuperAdmin(request.auth.uid));
      allow update, delete: if isSignedIn() && (isSuperAdmin(request.auth.uid) || (isMemberOfFamily(resource.data.get('familyId', null)) && isUserParentOrAdmin(request.auth.uid)));
    }

    // 12. Allowed Family Creators Collection (Whitelist)
    match /allowed_family_creators/{creatorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin(request.auth.uid);
    }

    // 13. Audit Logs Collection
    match /audit_logs/{logId} {
      allow get, list: if isSignedIn() && (isSuperAdmin(request.auth.uid) || isUserParentOrAdmin(request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isSuperAdmin(request.auth.uid);
    }

    // 14. Login Logs Collection
    match /login_logs/{logId} {
      allow get, list: if isSignedIn() && isSuperAdmin(request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isSuperAdmin(request.auth.uid);
    }

    // 15. Join Requests Collection
    match /join_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) || 
        isUserParentOrAdmin(request.auth.uid) || 
        resource.data.userId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) || 
        isUserParentOrAdmin(request.auth.uid) || 
        resource.data.userId == request.auth.uid
      );
    }

    // 16. Invites Collection
    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        isUserParentOrAdmin(request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid) ||
        isUserParentOrAdmin(request.auth.uid)
      );
    }
  }
}
